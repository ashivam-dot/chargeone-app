{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chargeone",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/charger/*", "/ev-charging/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chargeone",
      "database_id": "1a4296a3-3f2a-4d35-85bb-b45a839369d8",
      "migrations_dir": "worker/migrations"
    }
  ],
  // Workers AI for the trip copilot. `wrangler dev` runs it on the Cloudflare account it is logged into.
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "ENVIRONMENT": "production",
    // Public by design (OAuth web client ID and Firebase web config; not secrets). Firebase project
    // chargeone-512418 on the owner's personal Google account: Email/Password and Phone providers on,
    // authorised domains localhost and chargeone.akshshivam5.workers.dev.
    "GOOGLE_CLIENT_ID": "189004935714-6quqivutlq7dl3j5v2uh88iu24771hmu.apps.googleusercontent.com",
    "FIREBASE_API_KEY": "AIzaSyC_tHokToLD2hA9I5nvDypfJEIk_s6l7h4",
    "FIREBASE_PROJECT_ID": "chargeone-512418",
    "FIREBASE_AUTH_DOMAIN": "chargeone-512418.firebaseapp.com",
    "FIREBASE_APP_ID": "1:189004935714:web:353b18f1b14b423941907b",
    "RAZORPAY_KEY_ID": "",
    "RAZORPAY_PLAN_MONTHLY": "",
    "RAZORPAY_PLAN_YEARLY": "",
    "AGENT_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "AGENT_FALLBACK_MODEL": "@cf/zai-org/glm-4.7-flash"
  },
  // Secrets (set with `npx wrangler secret put <NAME>`, never committed):
  // SESSION_SECRET, ADMIN_TOKEN (admin console, 24+ chars), ORS_API_KEY, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET
  "env": {
    // CI: `wrangler dev --env ci` without a Cloudflare login, so no AI binding (the copilot answers 503).
    // Bindings and vars aren't inherited by environments, so they are repeated here.
    "ci": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "chargeone",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "worker/migrations"
        }
      ],
      "vars": {
        "ENVIRONMENT": "development",
        // CI runs offline from Google: no Google or Firebase sign-in there (the app hides those options).
        "GOOGLE_CLIENT_ID": "",
        "FIREBASE_API_KEY": "",
        "FIREBASE_PROJECT_ID": "",
        "RAZORPAY_KEY_ID": "",
        "RAZORPAY_PLAN_MONTHLY": "",
        "RAZORPAY_PLAN_YEARLY": "",
        "AGENT_MODEL": "@cf/google/gemma-4-26b-a4b-it",
        "AGENT_FALLBACK_MODEL": "@cf/zai-org/glm-4.7-flash"
      }
    }
  }
}
