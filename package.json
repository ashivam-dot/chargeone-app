{
  "name": "chargeone-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "setup:dev": "node scripts/setup-dev.ts && wrangler d1 migrations apply chargeone --local",
    "build": "npm run typecheck && vite build && node scripts/prerender.ts && node scripts/bundle-budget.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "import:data": "node scripts/import-data.ts",
    "import:places": "node scripts/import-places.ts",
    "icons": "node scripts/make-icons.ts",
    "smoke:api": "node scripts/api-smoke.ts",
    "deploy": "npm run build -- --require-site-url && wrangler d1 migrations apply chargeone --remote && wrangler deploy",
    "budget": "node scripts/bundle-budget.ts",
    "e2e": "playwright test",
    "e2e:slow": "playwright test --project=pixel-7 --grep @slow",
    "cap:build": "CAPACITOR=1 vite build && cap sync",
    "cap:android": "npm run cap:build && cap open android",
    "cap:ios": "npm run cap:build && cap open ios",
    "native:icons": "node scripts/native-icons.ts"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/capacitor-social-login": "8.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "lucide-preact": "1.59.0",
    "maplibre-gl": "^6.14.0",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@capacitor/cli": "8.5.3",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "workerd@1.20261012.1": true,
    "esbuild@0.28.2": true
  }
}
