/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://*.razorpay.com https://lh3.googleusercontent.com; font-src 'self' data:; connect-src 'self' https://tiles.openfreemap.org https://photon.komoot.io https://accounts.google.com/gsi/ https://*.razorpay.com; frame-src https://accounts.google.com/gsi/ https://api.razorpay.com https://checkout.razorpay.com; worker-src 'self' blob:; child-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(self "https://api.razorpay.com" "https://checkout.razorpay.com")
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=3600

/charger/*
  Cache-Control: public, max-age=3600

/ev-charging/*
  Cache-Control: public, max-age=3600
