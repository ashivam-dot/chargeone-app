{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["node", "vite/client", "vite-plugin-pwa/client"]
  },
  "include": ["src", "scripts", "pipeline", "vite.config.ts", "vite.admin.config.ts"],
  "exclude": ["scripts/trip-benchmark.ts", "scripts/drive-time-check.ts"]
}
